# Copy this file to ".env" (same folder) and add ONE key to power the AI assistant with a real LLM.
# Without a key the assistant still works: it answers from the live model output with templates.
#
# AQUASENSE_LLM_PROVIDER = auto | gemini | groq | anthropic | openai   (auto = first key found)
AQUASENSE_LLM_PROVIDER=auto

# Google Gemini  (free key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq  (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude  (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI  (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Simulation speed: seconds per simulated hour
AQUASENSE_TICK_SECONDS=3
